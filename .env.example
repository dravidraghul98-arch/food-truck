# Arabian Delights Food Truck Security & Environment Configuration

# 1. Database & Supabase Parameters
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.[YOUR_SUPABASE_PROJECT_ID].supabase.co:5432/postgres"
VITE_SUPABASE_URL="https://[YOUR_SUPABASE_PROJECT_ID].supabase.co"
VITE_SUPABASE_ANON_KEY="[YOUR_SUPABASE_ANON_KEY]"

# 2. Server Security & Environment
PORT=3001
NODE_ENV="development" # Set to "production" in production environment
JWT_SECRET="[YOUR_STRONG_JWT_SECRET_KEY]"

# 3. Owner Portal Authorization
OWNER_EMAIL="owner@arabiandelights.com"
OWNER_PASSWORD="[YOUR_STRONG_OWNER_PASSWORD]"

# 4. Payment Gateway Parameters (Razorpay)
RAZORPAY_KEY_ID="[YOUR_RAZORPAY_KEY_ID]"
RAZORPAY_KEY_SECRET="[YOUR_RAZORPAY_KEY_SECRET]"
VITE_RAZORPAY_KEY_ID="[YOUR_RAZORPAY_KEY_ID]"

# 5. Gemini AI Parameters
GEMINI_API_KEY="[YOUR_GEMINI_API_KEY]"
